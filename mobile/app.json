{
  "expo": {
    "name": "Solace AI",
    "slug": "solace-ai",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "solace",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#FDF8F3"
    },
    "android": {
      "package": "com.anikruhan.solaceai",
      "adaptiveIcon": {
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundColor": "#FDF8F3"
      },
      "permissions": [
        "POST_NOTIFICATIONS",
        "SCHEDULE_EXACT_ALARM",
        "VIBRATE"
      ]
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.anikruhan.solaceai"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-notifications",
        {
          "icon": "./assets/android-icon-monochrome.png",
          "color": "#7A9B76"
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": true
          }
        }
      ]
    ],
    "extra": {
      "apiUrl": "http://10.0.2.2:4000",
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "49ce478f-324a-4332-94a5-667e4ed4b16f"
      }
    },
    "icon": "./assets/icon.png",
    "experiments": {
      "typedRoutes": false
    },
    "owner": "aruhan7s-team"
  }
}
